def main():
    while True:
        print("\n" + "=" * 50)
        print("   PROGRAM ALGORITMA REKURSIF & BACKTRACKING")
        print("=" * 50)
        print("  1. N-Queens (N-Ratu)")
        print("  2. Knight's Tour (Tur Kuda)")
        print("  3. Knapsack (Masalah Karung)")
        print("  0. Keluar")
        print("-" * 50)

        pilihan = input("Pilih menu (0-3): ").strip()

        if pilihan == "1":
            run_nqueens()
        elif pilihan == "2":
            run_knights_tour()
        elif pilihan == "3":
            run_knapsack()
        elif pilihan == "0":
            print("\nProgram selesai. Terima kasih!")
            break
        else:
            print("Pilihan tidak valid, coba lagi.")

if __name__ == "__main__":
    main()
