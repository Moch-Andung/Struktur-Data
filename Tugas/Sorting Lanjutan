import math
from typing import List, Optional


# ── Node untuk Singly Linked List ──────────────────────────
class ListNode:
    def __init__(self, data, next=None):
        self.data = data
        self.next = next

    def __repr__(self):
        return f"ListNode({self.data})"


# ── Helper: cetak linked list ───────────────────────────────
def linked_list_to_list(head: Optional[ListNode]) -> list:
    result = []
    cur = head
    while cur:
        result.append(cur.data)
        cur = cur.next
    return result

def list_to_linked_list(lst: list) -> Optional[ListNode]:
    if not lst:
        return None
    head = ListNode(lst[0])
    cur = head
    for val in lst[1:]:
        cur.next = ListNode(val)
        cur = cur.next
    return head


# ============================================================
class AdvancedSorter:

    # =========================================================
    # 1. ARRAY MERGE SORT (Virtual Sublists + Single tmpArray)
    # =========================================================

    def sort_array(self, arr: List[int]) -> List[int]:
        """
        Merge Sort array menggunakan satu tmpArray statis.
        Tidak membuat sublist fisik di setiap rekursi.
        Kompleksitas: Waktu O(n log n), Ruang tambahan O(n).
        """
        if len(arr) <= 1:
            return arr
        tmp_array = [0] * len(arr)   # Satu-satunya alokasi tambahan
        self._rec_merge_sort(arr, 0, len(arr) - 1, tmp_array)
        return arr

    def _rec_merge_sort(self, arr, first, last, tmp_array):
        """Rekursi bagi-dan-taklukkan pada indeks virtual (bukan sublist)."""
        if first >= last:
            return
        mid = (first + last) // 2
        self._rec_merge_sort(arr, first, mid, tmp_array)
        self._rec_merge_sort(arr, mid + 1, last, tmp_array)
        self._merge_virtual(arr, first, mid, last, tmp_array)

    def _merge_virtual(self, arr, left_start, mid, right_end, tmp_array):
        """
        Gabungkan dua sublist virtual arr[left_start..mid] dan arr[mid+1..right_end].
        Hasil ditulis ke tmp_array lalu disalin kembali ke arr.
        STABLE: saat nilai sama, elemen kiri diambil dulu (kondisi <=).
        """
        a = left_start       # pointer sublist kiri
        b = mid + 1          # pointer sublist kanan
        k = left_start       # pointer tmp_array

        # Gabungkan selama kedua sublist masih punya elemen
        while a <= mid and b <= right_end:
            if arr[a] <= arr[b]:   # <= menjamin stabilitas
                tmp_array[k] = arr[a]
                a += 1
            else:
                tmp_array[k] = arr[b]
                b += 1
            k += 1

        # Salin sisa sublist kiri (jika ada)
        while a <= mid:
            tmp_array[k] = arr[a]
            a += 1
            k += 1

        # Salin sisa sublist kanan (jika ada)
        while b <= right_end:
            tmp_array[k] = arr[b]
            b += 1
            k += 1

        # Kembalikan hasil ke arr (hanya segmen yang baru digabung)
        for i in range(left_start, right_end + 1):
            arr[i] = tmp_array[i]


    # =========================================================
    # 2. LINKED LIST MERGE SORT (Fast-Slow + Dummy Merge)
    # =========================================================

    def sort_linked_list(self, head: Optional[ListNode]) -> Optional[ListNode]:
        """
        Merge Sort pada singly linked list.
        Hanya memodifikasi pointer .next, tidak mengalokasikan node baru.
        Kompleksitas: Waktu O(n log n), Ruang O(log n) untuk stack rekursi.
        """
        if head is None or head.next is None:
            return head

        # Pisahkan list menjadi dua bagian menggunakan fast-slow pointer
        right_head = self._split_linked_list(head)
        left_head = head   # head kini hanya menunjuk separuh kiri

        # Rekursi pada masing-masing bagian
        left_sorted  = self.sort_linked_list(left_head)
        right_sorted = self.sort_linked_list(right_head)

        # Gabungkan dua list yang sudah terurut
        return self._merge_linked_lists(left_sorted, right_sorted)

    def _split_linked_list(self, head: ListNode) -> Optional[ListNode]:
        """
        Temukan titik tengah list dalam SATU traversal menggunakan
        teknik fast-slow pointer (Floyd's algorithm):
          - midPoint  : bergerak 1 langkah per iterasi
          - curNode   : bergerak 2 langkah per iterasi
        Saat curNode mencapai akhir, midPoint berada di tengah.
        Putus link di midPoint, kembalikan head sublist kanan.
        """
        midPoint = head          # slow pointer
        curNode  = head.next     # fast pointer (dimulai 1 langkah lebih maju)

        while curNode is not None and curNode.next is not None:
            midPoint = midPoint.next       # maju 1
            curNode  = curNode.next.next   # maju 2

        # Simpan head sublist kanan lalu putus link
        right_head       = midPoint.next
        midPoint.next    = None   # akhiri sublist kiri

        return right_head

    def _merge_linked_lists(
        self,
        listA: Optional[ListNode],
        listB: Optional[ListNode]
    ) -> Optional[ListNode]:
        """
        Gabungkan dua sorted linked list menggunakan dummy node & tail reference.
        Tidak mengalokasikan node baru — hanya memodifikasi pointer .next.
        STABLE: saat nilai sama, node dari listA diambil dulu (kondisi <=).
        """
        dummy = ListNode(0)   # sentinel node, tidak masuk hasil akhir
        tail  = dummy

        while listA is not None and listB is not None:
            if listA.data <= listB.data:   # <= menjamin stabilitas
                tail.next = listA
                listA = listA.next
            else:
                tail.next = listB
                listB = listB.next
            tail = tail.next

        # Sambungkan sisa list yang belum habis (tidak perlu loop lagi)
        tail.next = listA if listA is not None else listB

        return dummy.next   # lewati sentinel


    # =========================================================
    # 3. QUICK SORT (Median-of-Three Pivot + Depth Limiter)
    # =========================================================

    def sort_quick(self, arr: List[int]) -> List[int]:
        """
        Entry point Quick Sort dengan depth limiter.
        Jika kedalaman rekursi melebihi 2*log2(n), fallback ke Merge Sort
        untuk menghindari kompleksitas O(n²).
        """
        if len(arr) <= 1:
            return arr
        max_depth = int(2 * math.log2(len(arr))) if len(arr) > 1 else 1
        self._quick_sort_recursive(arr, 0, len(arr) - 1, max_depth, depth=0)
        return arr

    def _quick_sort_recursive(self, arr, first, last, max_depth, depth):
        """Rekursi Quick Sort dengan pengecekan kedalaman."""
        if first >= last:
            return

        # Depth limiter: fallback ke Merge Sort jika terlalu dalam
        if depth > max_depth:
            # Urutkan segmen arr[first..last] menggunakan sort_array
            sub = arr[first:last + 1]
            self.sort_array(sub)
            arr[first:last + 1] = sub
            return

        pivot_idx = self.partition_quick(arr, first, last)
        self._quick_sort_recursive(arr, first, pivot_idx - 1, max_depth, depth + 1)
        self._quick_sort_recursive(arr, pivot_idx + 1, last, max_depth, depth + 1)

    def partition_quick(self, arr: List[int], first: int, last: int) -> int:
        """
        Partisi in-place dengan pivot Median-of-Three.

        Langkah:
          1. Hitung mid = (first + last) // 2
          2. Urutkan arr[first], arr[mid], arr[last] sehingga
             nilai median berada di arr[first] (digunakan sebagai pivot).
          3. Jalankan partisi standar (Lomuto-style dengan left/right scan).

        Catatan stabilitas: Quick Sort pada array secara inheren tidak stabil
        karena swap jarak jauh dapat mengubah urutan relatif elemen sama.
        Untuk kebutuhan stabilitas, gunakan sort_array (Merge Sort) sebagai gantinya.

        Returns: indeks akhir pivot setelah partisi.
        """
        mid = (first + last) // 2

        # --- Median-of-Three: tempatkan median di arr[first] ---
        # Urutkan ketiga kandidat secara minimal dengan 3 swap kondisional
        if arr[mid] < arr[first]:
            arr[first], arr[mid] = arr[mid], arr[first]
        if arr[last] < arr[first]:
            arr[first], arr[last] = arr[last], arr[first]
        if arr[mid] < arr[last]:
            arr[mid], arr[last] = arr[last], arr[mid]
        # Sekarang arr[first] <= arr[last] <= arr[mid] (median ada di arr[last])
        # Tukar median ke arr[first] agar menjadi pivot
        arr[first], arr[last] = arr[last], arr[first]

        pivot = arr[first]

        # --- Partisi standar (scan dari kiri dan kanan) ---
        left  = first + 1
        right = last

        while True:
            # Geser left ke kanan selama elemen < pivot
            while left <= right and arr[left] <= pivot:
                left += 1
            # Geser right ke kiri selama elemen > pivot
            while left <= right and arr[right] >= pivot:
                right -= 1

            if left > right:
                break

            # Tukar elemen yang salah sisi
            arr[left], arr[right] = arr[right], arr[left]

        # Tempatkan pivot di posisi akhirnya
        arr[first], arr[right] = arr[right], arr[first]

        return right   # indeks posisi pivot


# ============================================================
#  PENGUJIAN
# ============================================================

def run_tests():
    sorter = AdvancedSorter()
    print("=" * 60)
    print("   UJI COBA AdvancedSorter")
    print("=" * 60)

    # ── Test 1: Array Merge Sort ────────────────────────────
    print("\n[1] Array Merge Sort (sort_array)")
    tests = [
        [5, 3, 8, 1, 9, 2, 7, 4, 6],
        [1],
        [],
        [3, 3, 1, 1, 2, 2],          # test stabilitas (nilai duplikat)
        list(range(10, 0, -1)),       # descending
        [1, 2, 3, 4, 5],             # sudah terurut
    ]
    for t in tests:
        original = t[:]
        result = sorter.sort_array(t[:])
        expected = sorted(original)
        status = "OK" if result == expected else "FAIL"
        print(f"  [{status}] Input: {original[:8]}{'...' if len(original)>8 else ''} "
              f"-> {result[:8]}{'...' if len(result)>8 else ''}")

    # ── Test 2: Linked List Merge Sort ──────────────────────
    print("\n[2] Linked List Merge Sort (sort_linked_list)")
    ll_tests = [
        [5, 3, 8, 1, 9, 2],
        [1],
        [],
        [3, 1, 3, 1, 2],   # duplikat — uji stabilitas
        list(range(8, 0, -1)),
    ]
    for t in ll_tests:
        head = list_to_linked_list(t)
        sorted_head = sorter.sort_linked_list(head)
        result = linked_list_to_list(sorted_head)
        expected = sorted(t)
        status = "OK" if result == expected else "FAIL"
        print(f"  [{status}] Input: {t} -> {result}")

    # ── Test 3: Quick Sort ──────────────────────────────────
    print("\n[3] Quick Sort Median-of-Three (sort_quick)")
    qs_tests = [
        [5, 3, 8, 1, 9, 2, 7, 4, 6],
        list(range(20, 0, -1)),       # worst-case untuk naive pivot
        [1, 1, 1, 1],                # semua sama
        [42],
        [],
    ]
    for t in qs_tests:
        original = t[:]
        result = sorter.sort_quick(t[:])
        expected = sorted(original)
        status = "OK" if result == expected else "FAIL"
        print(f"  [{status}] Input: {original[:8]}{'...' if len(original)>8 else ''} "
              f"-> {result[:8]}{'...' if len(result)>8 else ''}")

    # ── Test 4: Depth Limiter (fallback ke Merge Sort) ──────
    print("\n[4] Depth Limiter — descending besar (n=100)")
    big = list(range(100, 0, -1))
    result = sorter.sort_quick(big[:])
    expected = list(range(1, 101))
    status = "OK" if result == expected else "FAIL"
    print(f"  [{status}] sort_quick(range(100,0,-1)) -> {result[:5]}...{result[-5:]}")

    print("\n" + "=" * 60)
    print("   SELESAI")
    print("=" * 60)


if __name__ == "__main__":
    run_tests()
